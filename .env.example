OPPORTUNITY_ENGINE_HOST=127.0.0.1
OPPORTUNITY_ENGINE_PORT=8000
OPPORTUNITY_ENGINE_DATABASE_PATH=data/opportunity_engine.db
OPPORTUNITY_ENGINE_CONSTITUTION_PATH=config/constitution.json
OPPORTUNITY_ENGINE_LOG_LEVEL=INFO
OPPORTUNITY_ENGINE_ENABLE_API_DOCS=true

# Required for scoring (Milestone 4). Separate from any claude.ai Pro/Max
# subscription -- generate a pay-as-you-go API key at console.anthropic.com.
# Read directly by the anthropic SDK; not prefixed like the settings above.
ANTHROPIC_API_KEY=

# Optional (v0.3): push a real-time notification to your phone via a
# Telegram bot when a new opportunity needs review. Unset = feature off.
# ntfy.sh was tried first but proved unreliable for iOS remote push in
# real testing (OE-ADR-035). To set up:
#   1. Message @BotFather in Telegram, send /newbot, follow the prompts.
#   2. Message your new bot once (bots can't message you first).
#   3. Use the Bot API's getUpdates endpoint to find your numeric chat ID.
OPPORTUNITY_ENGINE_TELEGRAM_BOT_TOKEN=
OPPORTUNITY_ENGINE_TELEGRAM_CHAT_ID=

# How often (minutes) the Telegram listener automatically checks every
# source and runs the expiration/reminder/approval sweeps on its own,
# without waiting for /newsearch (OE-ADR-036). <= 0 disables periodic
# checking entirely (manual /newsearch only).
OPPORTUNITY_ENGINE_BACKGROUND_CHECK_INTERVAL_MINUTES=30

# Optional: alert on employer replies to a dedicated, isolated mailbox
# via the Microsoft Graph API (OE-ADR-037). Unset client ID = feature
# off. Read-only (Mail.Read) -- never sends anything. One-time setup:
#   1. portal.azure.com -> App registrations -> New registration.
#      Supported account type: "Personal Microsoft accounts only"
#      (or the "any org + personal accounts" option -- either works
#      for a plain outlook.com account).
#   2. No redirect URI/platform needed -- this uses device-code flow,
#      a public client, so no client secret either.
#   3. API permissions -> Microsoft Graph -> Delegated -> add
#      Mail.Read and offline_access.
#   4. Copy the "Application (client) ID" below.
# First run prints a one-time device-code URL/code to sign in as
# lonestaritservices@outlook.com; the resulting token is cached and
# silently refreshed after that.
OPPORTUNITY_ENGINE_MS_GRAPH_CLIENT_ID=
OPPORTUNITY_ENGINE_MS_GRAPH_TENANT_ID=consumers

# How often (minutes) to check for new mail. Tighter than the job-board
# interval above since reply speed is the point of this feature, and
# Graph's delta queries are lightweight (not scraping a public feed).
OPPORTUNITY_ENGINE_MAIL_CHECK_INTERVAL_MINUTES=10

