OPPORTUNITY_ENGINE_HOST=127.0.0.1
OPPORTUNITY_ENGINE_PORT=8000
OPPORTUNITY_ENGINE_DATABASE_PATH=data/opportunity_engine.db
OPPORTUNITY_ENGINE_CONSTITUTION_PATH=config/constitution.json
OPPORTUNITY_ENGINE_LOG_LEVEL=INFO
OPPORTUNITY_ENGINE_ENABLE_API_DOCS=true

# Required for scoring (Milestone 4). Separate from any claude.ai Pro/Max
# subscription -- generate a pay-as-you-go API key at console.anthropic.com.
# Read directly by the anthropic SDK; not prefixed like the settings above.
ANTHROPIC_API_KEY=

# Optional (v0.3): push a real-time notification to your phone via a
# Telegram bot when a new opportunity needs review. Unset = feature off.
# ntfy.sh was tried first but proved unreliable for iOS remote push in
# real testing (OE-ADR-035). To set up:
#   1. Message @BotFather in Telegram, send /newbot, follow the prompts.
#   2. Message your new bot once (bots can't message you first).
#   3. Use the Bot API's getUpdates endpoint to find your numeric chat ID.
OPPORTUNITY_ENGINE_TELEGRAM_BOT_TOKEN=
OPPORTUNITY_ENGINE_TELEGRAM_CHAT_ID=

